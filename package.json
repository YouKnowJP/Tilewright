{
  "name": "tilewright",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "description": "A local-first tile map editor and original turn-based puzzle adventure game.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "test:browser": "node scripts/browser/checks.mjs",
    "build": "node scripts/build.mjs",
    "verify": "npm run check && npm test && npm run build",
    "test:browser:smoke": "node scripts/browser/release-smoke.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:repository": "node scripts/repository-files.mjs --check",
    "test:browser:migration": "node scripts/browser/migration-browser-checks.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YouKnowJP/Tilewright.git"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "homepage": "https://youknowjp.github.io/Tilewright/",
  "bugs": {
    "url": "https://github.com/YouKnowJP/Tilewright/issues"
  }
}
